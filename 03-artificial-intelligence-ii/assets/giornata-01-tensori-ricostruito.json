   "metadata": {},
   "outputs": [],
   "source": [
    "# [ERRORE ATTESO: InvalidArgumentError]\n",
    "mmprod = tf.matmul(\n",
    "    mm, mm\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
