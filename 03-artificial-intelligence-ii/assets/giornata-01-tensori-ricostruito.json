   "source": [
    "mm = tf.transpose(mm)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 32. tf.math, i tipi, e perché non mescolare NumPy e TensorFlow"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# [ERRORE ATTESO: InvalidArgumentError]\n",
    "sq = tf.math.sqrt(a)\n",
    "sq"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "## tf.math\n",
    "\n",
    "a = tf.constant([1,2,3], dtype=tf.float32)\n",
    "# b = tf.constant([4,5,6])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
