   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 33. gather e scatter: selezionare e aggiornare"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "## tensor dim (8,10,5) 8-modulo, 10-studenti, 5 matiere\n",
    "\n",
    "scores = tf.random.uniform(\n",
    "    (8, 10, 5),\n",
    "    minval=0,\n",
    "    maxval=31,\n",
    "    dtype=tf.int32\n",
    ")\n",
    "scores"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# scores per gli studenti first and third modules\n",
    "modules_index_g = [0, 2]\n",
    "g_scores = tf.gather(\n",
    "    scores,\n",
    "    indices=modules_index_g,\n",
    "    axis=1\n",
    ")"
   ]
  }
